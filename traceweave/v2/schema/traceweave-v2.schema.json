{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/glaydsonboa/traceweave/blob/main/traceweave/v2/schema/traceweave-v2.schema.json",
  "title": "Traceweave Causal Chain V2",
  "type": "object",
  "required": [
    "schema",
    "protocol_version",
    "chain_id",
    "authority",
    "created_at",
    "events",
    "publications",
    "status"
  ],
  "properties": {
    "schema": {"const": "traceweave.causal_chain.v2"},
    "protocol_version": {"const": "2"},
    "chain_id": {"type": "string", "minLength": 1},
    "authority": {"type": "string", "minLength": 1},
    "created_at": {"type": "string"},
    "status": {"enum": ["open", "closed"]},
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/event"}
    },
    "publications": {
      "type": "array",
      "items": {"$ref": "#/$defs/publication"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "event": {
      "type": "object",
      "required": [
        "event_id",
        "event_type",
        "observed_at",
        "session_id",
        "repository",
        "branch",
        "head_commit",
        "prev_event_sha256",
        "resume_from_event_sha256",
        "source_artifact",
        "source_sha256",
        "metadata",
        "event_sha256"
      ],
      "properties": {
        "event_id": {"type": "string"},
        "event_type": {"enum": ["START", "RESUME", "STOP"]},
        "observed_at": {"type": "string"},
        "session_id": {"type": "string", "minLength": 1},
        "repository": {"type": "string", "minLength": 1},
        "branch": {"type": "string", "minLength": 1},
        "head_commit": {"type": "string", "minLength": 1},
        "prev_event_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "resume_from_event_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "source_artifact": {"type": ["string", "null"]},
        "source_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "metadata": {"type": "object"},
        "event_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "materialization": {
      "type": "object",
      "required": ["native_ids", "public_sha256", "reference", "readback_confirmed"],
      "properties": {
        "native_ids": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"type": "string", "minLength": 1}
        },
        "public_sha256": {"$ref": "#/$defs/sha256"},
        "reference": {"type": ["string", "null"]},
        "readback_confirmed": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "publication": {
      "type": "object",
      "required": [
        "pair_key",
        "github_id",
        "notion_id",
        "source_sha256",
        "public_sha256",
        "transformed",
        "materializations"
      ],
      "properties": {
        "pair_key": {"type": "string", "minLength": 1},
        "github_id": {"type": "string", "minLength": 1},
        "notion_id": {"type": "string", "minLength": 1},
        "generated_at_timezone": {"type": "string", "minLength": 1},
        "source_sha256": {"$ref": "#/$defs/sha256"},
        "public_sha256": {"$ref": "#/$defs/sha256"},
        "transformed": {"type": "boolean"},
        "transformation": {"type": ["string", "null"]},
        "materializations": {
          "type": "object",
          "properties": {
            "github": {"$ref": "#/$defs/materialization"},
            "notion": {"$ref": "#/$defs/materialization"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
